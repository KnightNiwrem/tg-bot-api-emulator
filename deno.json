{
  "lock": false,
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env=DOMAIN,PORT --allow-import=cdn.jsdelivr.net,cdn.skypack.dev,jsr.io src/main.ts",
    "start": "deno run --allow-net --allow-env=DOMAIN,PORT --allow-import=cdn.jsdelivr.net,cdn.skypack.dev,jsr.io src/main.ts",
    "fmt:check": "deno fmt --check",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "check": "deno check --allow-import=cdn.jsdelivr.net,cdn.skypack.dev,jsr.io src/ tests/ clients/ && deno check --doc-only README.md docs/typescript-client.md",
    "architecture:check": "deno run -A fallow dead-code --boundary-violations",
    "openapi:lint": "npx --yes @redocly/cli@2.54.2 lint openapi/openapi.yaml",
    "test": "deno test --allow-net=127.0.0.1 --allow-import=cdn.jsdelivr.net,cdn.skypack.dev,jsr.io"
  },
  "imports": {
    "@grammyjs/runner/": "https://cdn.jsdelivr.net/gh/grammyjs/runner@^2.0.3/src/",
    "@std/yaml": "jsr:@std/yaml@^1.3.0",
    "fallow": "npm:fallow@3.31.0",
    "grammy/types": "https://cdn.jsdelivr.net/gh/grammyjs/grammY@^1.46.0/src/types.ts",
    "https://lib.deno.dev/x/grammy@v1/": "https://cdn.jsdelivr.net/gh/grammyjs/grammY@^1.46.0/src/",
    "hono": "jsr:@hono/hono@^4.13.7",
    "hono/route": "jsr:@hono/hono@^4.13.7/route",
    "hono/utils/http-status": "jsr:@hono/hono@^4.13.7/utils/http-status",
    "zod": "npm:zod@^4.6.5"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "compilerOptions": {
    "strict": true
  }
}
