{
  "lock": false,
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env=DOMAIN,PORT --allow-import=jsr.io src/main.ts",
    "start": "deno run --allow-net --allow-env=DOMAIN,PORT --allow-import=jsr.io src/main.ts",
    "fmt:check": "deno fmt --check",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "check": "deno check --allow-import=cdn.jsdelivr.net,cdn.skypack.dev,jsr.io src/ tests/ clients/ docs/clients/ && deno check --doc-only --allow-import=cdn.jsdelivr.net,cdn.skypack.dev,jsr.io README.md docs/clients/**/*.md",
    "architecture:check": "deno run -A fallow dead-code --boundary-violations",
    "openapi:lint": "npx --yes @redocly/cli@2.54.2 lint openapi/openapi.yaml",
    "openapi:coverage": "rm -f .openapi-conformance-records.jsonl && OPENAPI_CONFORMANCE_RECORD_FILE=.openapi-conformance-records.jsonl deno test --allow-net=127.0.0.1 --allow-read=. --allow-write=.openapi-conformance-records.jsonl --allow-env=OPENAPI_CONFORMANCE_RECORD_FILE --allow-import=cdn.jsdelivr.net,cdn.skypack.dev,jsr.io && deno run --allow-read=. tests/support/openapi_conformance/coverage_report.ts .openapi-conformance-records.jsonl",
    "test": "deno test --allow-net=127.0.0.1 --allow-read=. --allow-import=cdn.jsdelivr.net,cdn.skypack.dev,jsr.io"
  },
  "imports": {
    "@grammyjs/auto-retry": "https://cdn.jsdelivr.net/gh/grammyjs/auto-retry@v2.0.2/src/mod.ts",
    "@grammyjs/runner": "https://cdn.jsdelivr.net/gh/grammyjs/runner@v2.0.3/src/mod.ts",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/yaml": "jsr:@std/yaml@1.3.0",
    "ajv": "npm:ajv@8.17.1",
    "ajv-formats": "npm:ajv-formats@3.0.1",
    "fallow": "npm:fallow@3.31.0",
    "grammy": "https://cdn.jsdelivr.net/gh/grammyjs/grammY@v1.46.0/src/mod.ts",
    "grammy/types": "https://cdn.jsdelivr.net/gh/grammyjs/grammY@v1.46.0/src/types.ts",
    "grammy-types-reference": "https://cdn.jsdelivr.net/gh/grammyjs/types@5.0.0/mod.ts",
    "https://lib.deno.dev/x/grammy@v1/": "https://cdn.jsdelivr.net/gh/grammyjs/grammY@v1.46.0/src/",
    "hono": "jsr:@hono/hono@4.13.13",
    "hono/route": "jsr:@hono/hono@4.13.13/route",
    "hono/utils/http-status": "jsr:@hono/hono@4.13.13/utils/http-status",
    "zod": "npm:zod@4.6.5"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "compilerOptions": {
    "strict": true
  }
}
