{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "clients/typescript/in_process/mod.ts",
    "clients/typescript/mod.ts",
    "src/main.ts",
    "tests/support/openapi_conformance/coverage_report.ts"
  ],
  "rules": {
    "boundary-violation": "error"
  },
  "boundaries": {
    "zones": [
      {
        "name": "domain",
        "patterns": [
          "src/types/**/*.ts"
        ]
      },
      {
        "name": "session-timing",
        "patterns": [
          "src/timing/session/**/*.ts"
        ]
      },
      {
        "name": "system-timing",
        "patterns": [
          "src/timing/system/**/*.ts"
        ]
      },
      {
        "name": "repositories",
        "autoDiscover": [
          "src/repositories"
        ]
      },
      {
        "name": "change-staging",
        "patterns": [
          "src/transactions/staging/**/*.ts"
        ]
      },
      {
        "name": "session-transactions",
        "patterns": [
          "src/transactions/session/**/*.ts"
        ]
      },
      {
        "name": "session-lifetime",
        "patterns": [
          "src/services/session_lifetime/**/*.ts"
        ]
      },
      {
        "name": "session",
        "patterns": [
          "src/session/**/*.ts"
        ]
      },
      {
        "name": "bot-api-projection",
        "patterns": [
          "src/projections/**/*.ts"
        ]
      },
      {
        "name": "text-entity-detection",
        "patterns": [
          "src/text_entities/**/*.ts"
        ]
      },
      {
        "name": "media-inspection",
        "patterns": [
          "src/media/**/*.ts"
        ]
      },
      {
        "name": "domain-services",
        "patterns": [
          "src/services/domain/**/*.ts"
        ]
      },
      {
        "name": "bot-message-view",
        "patterns": [
          "src/services/bot_message_view/**/*.ts"
        ]
      },
      {
        "name": "update-delivery",
        "patterns": [
          "src/services/update_delivery/**/*.ts"
        ]
      },
      {
        "name": "update-polling",
        "patterns": [
          "src/services/update_polling/**/*.ts"
        ]
      },
      {
        "name": "webhook-delivery",
        "patterns": [
          "src/services/webhook_delivery/**/*.ts"
        ]
      },
      {
        "name": "update-consumers",
        "patterns": [
          "src/services/update_consumers/**/*.ts"
        ]
      },
      {
        "name": "bot-media-resolution",
        "patterns": [
          "src/services/bot_media_resolution/**/*.ts"
        ]
      },
      {
        "name": "bot-message-sending",
        "patterns": [
          "src/services/bot_message_sending/**/*.ts"
        ]
      },
      {
        "name": "bot-message-repetition",
        "patterns": [
          "src/services/bot_message_repetition/**/*.ts"
        ]
      },
      {
        "name": "bot-activity",
        "patterns": [
          "src/services/bot_activity/**/*.ts"
        ]
      },
      {
        "name": "application-services",
        "patterns": [
          "src/services/application/**/*.ts"
        ]
      },
      {
        "name": "composition",
        "patterns": [
          "src/composition/**/*.ts",
          "src/main.ts"
        ]
      },
      {
        "name": "http-grammar",
        "patterns": [
          "src/http_grammar/**/*.ts"
        ]
      },
      {
        "name": "control-contracts",
        "patterns": [
          "src/api/contracts/**/*.ts"
        ]
      },
      {
        "name": "transport",
        "patterns": [
          "src/api/**/*.ts"
        ]
      },
      {
        "name": "typescript-client-tests",
        "patterns": [
          "clients/typescript/**/*_test.ts",
          "clients/typescript/test_support/**/*.ts"
        ]
      },
      {
        "name": "in-process-emulator",
        "patterns": [
          "clients/typescript/in_process/**/*.ts"
        ]
      },
      {
        "name": "typescript-client",
        "patterns": [
          "clients/typescript/**/*.ts"
        ]
      }
    ],
    "rules": [
      {
        "from": "domain",
        "allow": []
      },
      {
        "from": "session-timing",
        "allow": []
      },
      {
        "from": "system-timing",
        "allow": [],
        "allowTypeOnly": [
          "session-timing"
        ]
      },
      {
        "from": "repositories",
        "allow": [
          "domain",
          "change-staging"
        ]
      },
      {
        "from": "repositories/account",
        "allow": [
          "domain"
        ]
      },
      {
        "from": "repositories/bot",
        "allow": [
          "domain"
        ]
      },
      {
        "from": "repositories/bot_update",
        "allow": [
          "domain",
          "session-timing",
          "change-staging"
        ]
      },
      {
        "from": "repositories/bot_activity_log",
        "allow": [
          "domain",
          "session-timing",
          "change-staging"
        ]
      },
      {
        "from": "repositories/web_resource",
        "allow": [
          "domain"
        ]
      },
      {
        "from": "change-staging",
        "allow": []
      },
      {
        "from": "session-transactions",
        "allow": [],
        "allowTypeOnly": [
          "domain"
        ]
      },
      {
        "from": "session-lifetime",
        "allow": []
      },
      {
        "from": "session",
        "allow": [],
        "allowTypeOnly": [
          "session-lifetime",
          "session-transactions",
          "domain",
          "domain-services",
          "bot-media-resolution",
          "bot-message-sending",
          "bot-message-repetition",
          "bot-message-view",
          "bot-activity",
          "update-consumers",
          "webhook-delivery"
        ]
      },
      {
        "from": "repositories/session",
        "allow": [],
        "allowTypeOnly": [
          "session"
        ]
      },
      {
        "from": "bot-api-projection",
        "allow": [
          "domain"
        ]
      },
      {
        "from": "text-entity-detection",
        "allow": [
          "domain"
        ]
      },
      {
        "from": "media-inspection",
        "allow": [
          "domain"
        ]
      },
      {
        "from": "domain-services",
        "allow": [
          "domain",
          "http-grammar",
          "text-entity-detection",
          "media-inspection"
        ],
        "allowTypeOnly": [
          "repositories/account",
          "repositories/bot",
          "repositories/shared_chat",
          "repositories/chat_invite_link",
          "repositories/telegram_identity",
          "session-timing"
        ]
      },
      {
        "from": "bot-message-view",
        "allow": [
          "domain",
          "bot-api-projection"
        ]
      },
      {
        "from": "update-delivery",
        "allow": [
          "domain"
        ]
      },
      {
        "from": "update-polling",
        "allow": [
          "domain"
        ],
        "allowTypeOnly": [
          "session-timing"
        ]
      },
      {
        "from": "webhook-delivery",
        "allow": [
          "domain"
        ],
        "allowTypeOnly": [
          "session-timing"
        ]
      },
      {
        "from": "update-consumers",
        "allow": [
          "domain"
        ],
        "allowTypeOnly": [
          "update-polling",
          "webhook-delivery"
        ]
      },
      {
        "from": "bot-media-resolution",
        "allow": [
          "domain",
          "media-inspection"
        ],
        "allowTypeOnly": [
          "domain-services"
        ]
      },
      {
        "from": "bot-message-sending",
        "allow": [
          "domain"
        ],
        "allowTypeOnly": [
          "domain-services"
        ]
      },
      {
        "from": "bot-message-repetition",
        "allow": [
          "domain"
        ],
        "allowTypeOnly": [
          "domain-services",
          "bot-message-sending"
        ]
      },
      {
        "from": "bot-activity",
        "allow": [
          "domain"
        ],
        "allowTypeOnly": [
          "session-timing"
        ]
      },
      {
        "from": "application-services",
        "allow": [],
        "allowTypeOnly": [
          "session"
        ]
      },
      {
        "from": "composition",
        "allow": [
          "domain",
          "session-timing",
          "system-timing",
          "session-lifetime",
          "change-staging",
          "session-transactions",
          "repositories",
          "bot-api-projection",
          "domain-services",
          "bot-message-view",
          "update-delivery",
          "update-polling",
          "webhook-delivery",
          "update-consumers",
          "bot-media-resolution",
          "bot-message-sending",
          "bot-message-repetition",
          "bot-activity",
          "application-services",
          "session",
          "transport"
        ]
      },
      {
        "from": "http-grammar",
        "allow": []
      },
      {
        "from": "control-contracts",
        "allow": [
          "http-grammar"
        ]
      },
      {
        "from": "transport",
        "allow": [
          "domain",
          "control-contracts",
          "http-grammar",
          "text-entity-detection",
          "transport"
        ],
        "allowTypeOnly": [
          "session"
        ]
      },
      {
        "from": "typescript-client",
        "allow": [
          "control-contracts",
          "http-grammar"
        ]
      },
      {
        "from": "in-process-emulator",
        "allow": [
          "composition",
          "transport",
          "typescript-client"
        ]
      }
    ],
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": [
        "tests/**",
        "docs/**"
      ]
    }
  }
}
